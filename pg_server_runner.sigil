module pg_server_runner
  targets server
  trust none

use db.database.open_database;
use db.pg_auth.ScramVerifier;
use db.pg_auth.create_verifier;
use db.pg_server.serve;

fn load_verifier() -> Result<ScramVerifier, String>
  intent "環境変数の認証情報から SCRAM 検証子を生成する"
  requires none
  ensures none
  effects env, random, task.suspend
{
  let password = env.get(&"SIGIL_DB_PASSWORD").unwrap_or("");
  if password == "" {
    return Err("Missing SIGIL_DB_PASSWORD");
  }
  return create_verifier(&Secret.from_bytes(password.as_bytes()), 4096).map_err(|error| "SCRAM verifier initialization failed");
}

fn run_server() -> Result<Bool, String>
  intent "設定を読み、ソケットを開いて受け付けを続ける"
  requires none
  ensures none
  effects clock, console, env, fs, net.server, random, task
{
  let dir = env.get(&"SIGIL_DB_DIR").unwrap_or("");
  let user = env.get(&"SIGIL_DB_USER").unwrap_or("");
  let database_name = env.get(&"SIGIL_DB_NAME").unwrap_or("");
  let host = env.get(&"SIGIL_DB_HOST").unwrap_or("127.0.0.1");
  let port = env.get(&"SIGIL_DB_PORT").unwrap_or("5432").parse_int().unwrap_or(-1);
  let wait_ms = env.get(&"SIGIL_DB_WAIT_MS").unwrap_or("60000").parse_int().unwrap_or(-1);
  if dir == "" || user == "" || database_name == "" || port < 0 || port > 65535 || wait_ms <= 0 {
    return Err("Invalid Sigil DB server configuration");
  }
  let verifier = load_verifier()?;
  let id = random.bytes(16).ok_or("Database identifier initialization failed")?;
  let database = open_database(dir, id).map_err(|error| "Database open failed")?;
  let listener = net.listen(&host, port, 64).map_err(|error| "TCP listen failed")?;
  console.log(&listener.local_port());
  return serve(&listener, database, user, database_name, verifier, wait_ms).map_err(|error| "TCP server stopped");
}

pub fn main() -> Int
  intent "設定したローカル TCP アドレスで PostgreSQL v3 サーバーを起動する"
  requires none
  ensures none
  effects clock, console, env, fs, net.server, random, task
{
  match run_server() {
    Ok(_) => {
      return 0;
    }
    Err(message) => {
      console.log(&message);
    }
  }
  return 1;
}
