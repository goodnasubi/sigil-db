module test_runner
  targets server
  trust none

use tests.test_acid.run_acid_tests;
use tests.test_backup.run_backup_tests;
use tests.test_btree.run_btree_tests;
use tests.test_carryover.run_carryover_tests;
use tests.test_compat.run_compat_tests;
use tests.test_crash.run_crash_tests;
use tests.test_fixture.run_fixture_tests;
use tests.test_format.run_format_tests;
use tests.test_fuzz.run_fuzz_tests;
use tests.test_limits.run_limits_tests;
use tests.test_relation.run_relation_tests;
use tests.test_types.run_types_tests;
use tests.test_wal.run_wal_tests;

pub fn main() -> Int
  intent "すべてのテストを実行し、全合格なら 0、不合格があれば 1 以上のエラーコードを返す"
  requires none
  ensures none
  effects console, fs
{
  if !run_limits_tests() {
    return 1;
  }
  if !run_types_tests() {
    return 2;
  }
  if !run_format_tests() {
    return 3;
  }
  if !run_fixture_tests() {
    return 4;
  }
  if !run_wal_tests() {
    return 5;
  }
  if !run_btree_tests() {
    return 6;
  }
  if !run_relation_tests() {
    return 7;
  }
  if !run_carryover_tests() {
    return 8;
  }
  if !run_backup_tests() {
    return 9;
  }
  if !run_compat_tests() {
    return 10;
  }
  if !run_acid_tests() {
    return 11;
  }
  if !run_crash_tests() {
    return 12;
  }
  if !run_fuzz_tests() {
    return 13;
  }
  return 0;
}
