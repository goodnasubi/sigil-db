module db.error
  targets server
  trust none

// ADR 0045 決定 1・2・3: データベース核の構造化エラー

pub enum DbError {
  Limit(String),
  UnsupportedFormat(Int),
  Corrupt(String),
  TypeMismatch(String),
  Busy(String),
  CommitUnknown(String),
  Io(String),
}

pub fn error_kind_name(err: &DbError) -> String
  intent "エラー種別の名前を返す"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => "Limit",
    DbError.UnsupportedFormat(_) => "UnsupportedFormat",
    DbError.Corrupt(_) => "Corrupt",
    DbError.TypeMismatch(_) => "TypeMismatch",
    DbError.Busy(_) => "Busy",
    DbError.CommitUnknown(_) => "CommitUnknown",
    DbError.Io(_) => "Io",
  };
}

pub fn error_message(err: &DbError) -> String
  intent "エラーメッセージを返す"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(msg) => msg.clone(),
    DbError.UnsupportedFormat(_) => "unsupported format",
    DbError.Corrupt(msg) => msg.clone(),
    DbError.TypeMismatch(msg) => msg.clone(),
    DbError.Busy(msg) => msg.clone(),
    DbError.CommitUnknown(msg) => msg.clone(),
    DbError.Io(msg) => msg.clone(),
  };
}

pub fn is_limit(err: &DbError) -> Bool
  intent "Limit エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => true,
    DbError.UnsupportedFormat(_) => false,
    DbError.Corrupt(_) => false,
    DbError.TypeMismatch(_) => false,
    DbError.Busy(_) => false,
    DbError.CommitUnknown(_) => false,
    DbError.Io(_) => false,
  };
}

pub fn is_unsupported_format(err: &DbError) -> Bool
  intent "UnsupportedFormat エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => false,
    DbError.UnsupportedFormat(_) => true,
    DbError.Corrupt(_) => false,
    DbError.TypeMismatch(_) => false,
    DbError.Busy(_) => false,
    DbError.CommitUnknown(_) => false,
    DbError.Io(_) => false,
  };
}

pub fn is_corrupt(err: &DbError) -> Bool
  intent "Corrupt エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => false,
    DbError.UnsupportedFormat(_) => false,
    DbError.Corrupt(_) => true,
    DbError.TypeMismatch(_) => false,
    DbError.Busy(_) => false,
    DbError.CommitUnknown(_) => false,
    DbError.Io(_) => false,
  };
}

pub fn is_type_mismatch(err: &DbError) -> Bool
  intent "TypeMismatch エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => false,
    DbError.UnsupportedFormat(_) => false,
    DbError.Corrupt(_) => false,
    DbError.TypeMismatch(_) => true,
    DbError.Busy(_) => false,
    DbError.CommitUnknown(_) => false,
    DbError.Io(_) => false,
  };
}

pub fn is_busy(err: &DbError) -> Bool
  intent "Busy エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => false,
    DbError.UnsupportedFormat(_) => false,
    DbError.Corrupt(_) => false,
    DbError.TypeMismatch(_) => false,
    DbError.Busy(_) => true,
    DbError.CommitUnknown(_) => false,
    DbError.Io(_) => false,
  };
}

pub fn is_commit_unknown(err: &DbError) -> Bool
  intent "CommitUnknown エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => false,
    DbError.UnsupportedFormat(_) => false,
    DbError.Corrupt(_) => false,
    DbError.TypeMismatch(_) => false,
    DbError.Busy(_) => false,
    DbError.CommitUnknown(_) => true,
    DbError.Io(_) => false,
  };
}

pub fn is_io(err: &DbError) -> Bool
  intent "Io エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => false,
    DbError.UnsupportedFormat(_) => false,
    DbError.Corrupt(_) => false,
    DbError.TypeMismatch(_) => false,
    DbError.Busy(_) => false,
    DbError.CommitUnknown(_) => false,
    DbError.Io(_) => true,
  };
}
