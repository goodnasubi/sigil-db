module db.error
  targets server
  trust none

// ADR 0045 決定 1・2・3: データベース核の構造化エラー
// 第 3 段（関係 API と索引）で、制約違反・存在検査・スキーマ不正・tx 中止の種別を追加した。
//   DuplicateKey    : 主キーの重複（insert）
//   UniqueViolation : 一意索引の違反
//   NotFound        : 存在しない表・索引・行（replace の対象行など）
//   Exists          : 既に存在する表・索引の作成
//   InvalidSchema   : 表・索引・列の定義が不正（名前・列数・主キー指定など）
//   TxAborted       : API エラー後の tx への操作（rollback だけが許される）

pub enum DbError {
  Limit(String),
  UnsupportedFormat(Int),
  Corrupt(String),
  TypeMismatch(String),
  Busy(String),
  CommitUnknown(String),
  Io(String),
  DuplicateKey(String),
  UniqueViolation(String),
  NotFound(String),
  Exists(String),
  InvalidSchema(String),
  TxAborted(String),
}

pub fn error_kind_name(err: &DbError) -> String
  intent "エラー種別の名前を返す"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => "Limit",
    DbError.UnsupportedFormat(_) => "UnsupportedFormat",
    DbError.Corrupt(_) => "Corrupt",
    DbError.TypeMismatch(_) => "TypeMismatch",
    DbError.Busy(_) => "Busy",
    DbError.CommitUnknown(_) => "CommitUnknown",
    DbError.Io(_) => "Io",
    DbError.DuplicateKey(_) => "DuplicateKey",
    DbError.UniqueViolation(_) => "UniqueViolation",
    DbError.NotFound(_) => "NotFound",
    DbError.Exists(_) => "Exists",
    DbError.InvalidSchema(_) => "InvalidSchema",
    DbError.TxAborted(_) => "TxAborted",
  };
}

pub fn error_message(err: &DbError) -> String
  intent "エラーメッセージを返す"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(msg) => msg.clone(),
    DbError.UnsupportedFormat(_) => "unsupported format",
    DbError.Corrupt(msg) => msg.clone(),
    DbError.TypeMismatch(msg) => msg.clone(),
    DbError.Busy(msg) => msg.clone(),
    DbError.CommitUnknown(msg) => msg.clone(),
    DbError.Io(msg) => msg.clone(),
    DbError.DuplicateKey(msg) => msg.clone(),
    DbError.UniqueViolation(msg) => msg.clone(),
    DbError.NotFound(msg) => msg.clone(),
    DbError.Exists(msg) => msg.clone(),
    DbError.InvalidSchema(msg) => msg.clone(),
    DbError.TxAborted(msg) => msg.clone(),
  };
}

pub fn is_limit(err: &DbError) -> Bool
  intent "Limit エラーかどうかを判定する"
  requires none
  ensures none
  effects none
{
  return match err {
    DbError.Limit(_) => true,
    _ => false,
  };
}

