module db.format
  targets server
  trust none

use db.error.DbError;
use db.limits.header_size;
use db.limits.max_page_count;

// ADR 0045 決定 1: 保存形式 v1 の定義と符号化・復号・検査
// ヘッダレイアウト（固定 96 byte）:
// 0..8   : magic (8 byte)
// 8..12  : version (4 byte LE) - v1 は 1
// 12..14 : byte_order (2 byte LE) - LE は 1
// 14..16 : kind (2 byte LE) - ページ種別または WAL レコード種別
// 16..20 : length (4 byte LE) - ページは 8192、WAL レコードは総長
// 20..24 : reserved (4 byte LE) - 0
// 24..40 : db_id (16 byte) - DB 識別子
// 40..48 : generation (8 byte LE) - 世代番号
// 48..56 : page_no_or_lsn (8 byte LE) - ページ番号または LSN
// 56..60 : item_count_or_tx_id (4 byte LE) - ページ内要素数または tx_id
// 60..64 : content_offset (4 byte LE) - ページ内データ開始位置または予備
// 64..96 : checksum (32 byte) - この領域を 0 埋めした全体の SHA-256 検査値

// ---------------------------------------------------------------------------
// マジックバイト定数（8 byte）
// ---------------------------------------------------------------------------

pub fn db_file_magic() -> Bytes
  intent "DB ファイルヘッダのマジックバイト (SIGILDB1) を返す"
  requires none
  ensures result.len() == 8
  effects none
{
  let mut m = Bytes.new();
  m.push(83);  // 'S'
  m.push(73);  // 'I'
  m.push(71);  // 'G'
  m.push(73);  // 'I'
  m.push(76);  // 'L'
  m.push(68);  // 'D'
  m.push(66);  // 'B'
  m.push(49);  // '1'
  return m;
}

pub fn page_magic() -> Bytes
  intent "ページヘッダのマジックバイト (SIGILPG1) を返す"
  requires none
  ensures result.len() == 8
  effects none
{
  let mut m = Bytes.new();
  m.push(83);  // 'S'
  m.push(73);  // 'I'
  m.push(71);  // 'G'
  m.push(73);  // 'I'
  m.push(76);  // 'L'
  m.push(80);  // 'P'
  m.push(71);  // 'G'
  m.push(49);  // '1'
  return m;
}

pub fn wal_magic() -> Bytes
  intent "WAL レコードのマジックバイト (SIGILWL1) を返す"
  requires none
  ensures result.len() == 8
  effects none
{
  let mut m = Bytes.new();
  m.push(83);  // 'S'
  m.push(73);  // 'I'
  m.push(71);  // 'G'
  m.push(73);  // 'I'
  m.push(76);  // 'L'
  m.push(87);  // 'W'
  m.push(76);  // 'L'
  m.push(49);  // '1'
  return m;
}

// ---------------------------------------------------------------------------
// 形式版とバイト順
// ---------------------------------------------------------------------------

pub fn format_version_v1() -> Int
  intent "保存形式の初版 (v1 = 1) を返す"
  requires none
  ensures result == 1
  effects none
{
  return 1;
}

pub fn byte_order_le() -> Int
  intent "固定リトルエンディアン (LE = 1) を返す"
  requires none
  ensures result == 1
  effects none
{
  return 1;
}

