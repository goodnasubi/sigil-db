// ページ種別
// ---------------------------------------------------------------------------

pub fn page_type_meta() -> Int
  intent "メタページ種別 (1) を返す"
  requires none
  ensures result == 1
  effects none
{
  return 1;
}

pub fn page_type_btree_leaf() -> Int
  intent "B+tree 葉ページ種別 (2) を返す"
  requires none
  ensures result == 2
  effects none
{
  return 2;
}

pub fn page_type_btree_interior() -> Int
  intent "B+tree 内部ノード種別 (3) を返す"
  requires none
  ensures result == 3
  effects none
{
  return 3;
}

pub fn page_type_free() -> Int
  intent "空きページ種別 (4) を返す"
  requires none
  ensures result == 4
  effects none
{
  return 4;
}

