module db.wal
  targets server
  trust none

use db.error.DbError;
use db.format.Header;
use db.format.apply_checksum;
use db.format.decode_and_verify_header;
use db.format.encode_header;
use db.format.new_header;
use db.format.push_u64_le;
use db.format.read_u64_le;
use db.format.wal_magic;
use db.format.wal_record_checkpoint;
use db.format.wal_record_page_redo;
use db.format.wal_record_tx_abort;
use db.format.wal_record_tx_begin;
use db.format.wal_record_tx_commit;
use db.limits.header_size;
use db.limits.max_page_count;
use db.limits.max_tx_wal_bytes;
use db.limits.page_size;
use db.page.verify_page_integrity;

// ADR 0045 決定 1・2・3: WAL レコード形式 v1
// 全レコードは固定 96 byte ヘッダ（magic: SIGILWL1, version: 1, byte_order: LE,
// 長さ, db_id, 世代, LSN, tx_id, 検査値）を持ち、Redo レコードは 8192 byte の全ページ像を運ぶ。

// ---------------------------------------------------------------------------
// tx 開始レコードの作成
// ---------------------------------------------------------------------------

pub fn create_tx_begin_record(db_id: &Bytes, generation: Int, lsn: Int, tx_id: Int) -> Bytes
  intent "WAL tx 開始レコード (96B) を構築する"
  requires db_id.len() == 16
  ensures result.len() == 96
  effects none
{
  let h = new_header(wal_magic(), 1, wal_record_tx_begin(), header_size(), db_id.clone(), generation, lsn, tx_id, 0);
  let mut rec = encode_header(&h);
  apply_checksum(&mut rec);
  return rec;
}

// ---------------------------------------------------------------------------
// ページ Redo レコードの作成 (全ページ像 8192 byte 保持、総長 8288 byte)
// ADR 0045: "変更した全ページ像と割当て情報を WAL に追記する。no-steal"
// ---------------------------------------------------------------------------

pub fn create_page_redo_record(db_id: &Bytes, generation: Int, lsn: Int, tx_id: Int, page_no: Int, page_data: &Bytes) -> Result<Bytes, DbError>
  intent "全ページ像を保持する WAL ページ Redo レコード (8288B) を構築する"
  requires db_id.len() == 16
  ensures none
  effects none
{
  if page_data.len() != page_size() {
    return Err(DbError.Corrupt("redo page data must be exactly 8192 bytes"));
  }
  if page_no < 0 || page_no >= max_page_count() {
    return Err(DbError.Limit("page number exceeds max_page_count (2^24)"));
  }

  let total_len = header_size() + page_size();
  let h = new_header(wal_magic(), 1, wal_record_page_redo(), total_len, db_id.clone(), generation, lsn, tx_id, page_no);
  // content_offset に page_no を格納
  let mut rec = encode_header(&h);
  rec.extend(&page_data);
  apply_checksum(&mut rec);
  return Ok(rec);
}

// ---------------------------------------------------------------------------
// tx コミットレコードの作成 (束ねる検査値・件数・範囲を保持)
// ADR 0045: "全レコードを束ねる検査値・件数・範囲を持つ commit レコード"
// ---------------------------------------------------------------------------

pub fn create_tx_commit_record(db_id: &Bytes, generation: Int, lsn: Int, tx_id: Int, record_count: Int, first_lsn: Int, bundle_checksum: &Bytes) -> Result<Bytes, DbError>
  intent "WAL tx コミットレコード (144B: ヘッダ 96B + commit メタデータ 48B) を構築する"
  requires db_id.len() == 16
  ensures none
  effects none
{
  if bundle_checksum.len() != 32 {
    return Err(DbError.Corrupt("bundle_checksum must be exactly 32 bytes"));
  }
  if record_count < 2 {
    return Err(DbError.Corrupt("record_count must be at least 2"));
  }
  if first_lsn < 0 || lsn < 0 || first_lsn > lsn || lsn - first_lsn != record_count - 1 {
    return Err(DbError.Corrupt("invalid LSN range or record_count: must satisfy last_lsn - first_lsn == record_count - 1"));
  }

  let total_len = header_size() + 48;
  let h = new_header(wal_magic(), 1, wal_record_tx_commit(), total_len, db_id.clone(), generation, lsn, tx_id, record_count);
  let mut rec = encode_header(&h);
  push_u64_le(&mut rec, first_lsn);
  push_u64_le(&mut rec, lsn);
  rec.extend(&bundle_checksum);
  apply_checksum(&mut rec);
  return Ok(rec);
}

// ---------------------------------------------------------------------------
// tx 中止レコードの作成
// ---------------------------------------------------------------------------

pub fn create_tx_abort_record(db_id: &Bytes, generation: Int, lsn: Int, tx_id: Int) -> Bytes
  intent "WAL tx 中止レコード (96B) を構築する"
  requires db_id.len() == 16
  ensures result.len() == 96
  effects none
{
  let h = new_header(wal_magic(), 1, wal_record_tx_abort(), header_size(), db_id.clone(), generation, lsn, tx_id, 0);
  let mut rec = encode_header(&h);
  apply_checksum(&mut rec);
  return rec;
}

// ---------------------------------------------------------------------------
// チェックポイントレコードの作成
// ---------------------------------------------------------------------------

pub fn create_checkpoint_record(db_id: &Bytes, generation: Int, lsn: Int, checkpointed_lsn: Int) -> Bytes
  intent "WAL チェックポイントレコード (104B: ヘッダ 96B + 確定 LSN 8B) を構築する"
  requires db_id.len() == 16
  ensures result.len() == 104
  effects none
{
  let total_len = header_size() + 8;
  let h = new_header(wal_magic(), 1, wal_record_checkpoint(), total_len, db_id.clone(), generation, lsn, 0, 0);
  let mut rec = encode_header(&h);
  push_u64_le(&mut rec, checkpointed_lsn);
  apply_checksum(&mut rec);
  return rec;
}

// ---------------------------------------------------------------------------
// WAL レコードの検証 (マジック・版・種別・長さ・上限・SHA-256 検査値)
// ---------------------------------------------------------------------------

pub fn verify_wal_record(record: &Bytes) -> Result<Header, DbError>
  intent "WAL レコードの完全性、版、種別・長さ整合性、検査値を検証する"
  requires none
  ensures none
  effects none
{
  if record.len() < header_size() {
    return Err(DbError.Corrupt("WAL record truncated: length < 96"));
  }
  if record.len() > max_tx_wal_bytes() {
    return Err(DbError.Limit("WAL record length exceeds max_tx_wal_bytes (64 MiB)"));
  }

  let wm = wal_magic();
  match decode_and_verify_header(&record, &wm, record.len()) {
    Err(e) => {
      return Err(e);
    }
    Ok(h) => {
      // 1. 種別検証 (1〜5 の範囲外は Corrupt)
      let k = h.kind;
      if k < 1 || k > 5 {
        return Err(DbError.Corrupt("unknown or unsupported WAL record kind"));
      }

      // 2. 種別ごとの固定長検査
      let mut expected_len = 0;
      if k == wal_record_tx_begin() {
        expected_len = header_size();
      } else if k == wal_record_page_redo() {
        expected_len = header_size() + page_size();
      } else if k == wal_record_tx_commit() {
        expected_len = header_size() + 48;
      } else if k == wal_record_tx_abort() {
        expected_len = header_size();
      } else if k == wal_record_checkpoint() {
        expected_len = header_size() + 8;
      }

      if record.len() != expected_len {
        return Err(DbError.Corrupt("WAL record length does not match expected length for record kind"));
      }

      // 3. 種別固有の境界・整合性検査
      if k == wal_record_page_redo() {
        // 保存データの不整合検証として page_no 上限検査（Corrupt に統一）
        if h.content_offset < 0 || h.content_offset >= max_page_count() {
          return Err(DbError.Corrupt("WAL redo page_no exceeds max_page_count (2^24)"));
        }
      } else if k == wal_record_tx_commit() {
        let record_count = h.content_offset;
        if record_count < 2 {
          return Err(DbError.Corrupt("WAL commit record_count must be at least 2"));
        }
        let first_lsn = read_u64_le(&record, header_size()).unwrap_or(0);
        let last_lsn = read_u64_le(&record, header_size() + 8).unwrap_or(0);
        if first_lsn < 0 || last_lsn < 0 || first_lsn > last_lsn || last_lsn != h.page_no_or_lsn || last_lsn - first_lsn != record_count - 1 {
          return Err(DbError.Corrupt("WAL commit LSN range or record_count invalid"));
        }
      } else if k == wal_record_checkpoint() {
        let cp_lsn = read_u64_le(&record, header_size()).unwrap_or(0);
        if cp_lsn < 0 || cp_lsn > h.page_no_or_lsn {
          return Err(DbError.Corrupt("WAL checkpoint checkpointed_lsn invalid"));
        }
      }

      return Ok(h);
    }
  }
}

// ---------------------------------------------------------------------------
// Redo レコードから全ページ像 (8192 byte) を取り出す
// ---------------------------------------------------------------------------

pub fn extract_redo_page(record: &Bytes) -> Result<Bytes, DbError>
  intent "Redo レコードから 8192 byte の全ページ像を安全に取り出し、ページ整合性と一致を検証する"
  requires none
  ensures none
  effects none
{
  match verify_wal_record(&record) {
    Err(e) => {
      return Err(e);
    }
    Ok(h) => {
      if h.kind != wal_record_page_redo() {
        return Err(DbError.Corrupt("record is not a page redo record"));
      }
      let expected_len = header_size() + page_size();
      let mut page_data = Bytes.new();
      match record.slice(header_size(), expected_len) {
        Err(e) => {
          return Err(DbError.Corrupt(e));
        }
        Ok(b) => {
          page_data = b;
        }
      }

      // 埋め込まれたページ像のヘッダ・検査値・ページ番号・世代・DB ID を検証照合
      match verify_page_integrity(&page_data) {
        Err(e) => {
          return Err(e);
        }
        Ok(page_h) => {
          if page_h.page_no_or_lsn != h.content_offset {
            return Err(DbError.Corrupt("embedded page page_no does not match redo record target page_no"));
          }
          if page_h.generation != h.generation {
            return Err(DbError.Corrupt("embedded page generation does not match redo record generation"));
          }
          if !ct_eq(&page_h.db_id, &h.db_id) {
            return Err(DbError.Corrupt("embedded page db_id does not match redo record db_id"));
          }

          return Ok(page_data);
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// トランザクション bundle_checksum の計算と検証 (ADR 0045 決定 3 準拠)
// ---------------------------------------------------------------------------

pub fn compute_tx_bundle_checksum(records: &List<Bytes>) -> Result<Bytes, DbError>
  intent "同 tx の Begin から Commit 直前までの全 WAL レコード（LSN 昇順）を連結したバイト列の SHA-256 を計算する"
  requires none
  ensures none
  effects none
{
  if records.len() == 0 {
    return Err(DbError.Corrupt("cannot compute bundle checksum for empty records list"));
  }
  let mut concat = Bytes.new();
  let mut i = 0;
  while i < records.len() {
    let rec = records.get(i);
    match rec {
      None => {
        return Err(DbError.Corrupt("missing record in records list"));
      }
      Some(r) => {
        concat.extend(&r);
      }
    }
    i = i + 1;
  }
  return Ok(sha256(&concat));
}

pub fn verify_tx_bundle_checksum(records: &List<Bytes>, expected_bundle_checksum: &Bytes) -> Result<Bool, DbError>
  intent "先行レコード列から計算した bundle_checksum とコミットレコードの検査値を定数時間比較で照合する"
  requires none
  ensures none
  effects none
{
  if expected_bundle_checksum.len() != 32 {
    return Err(DbError.Corrupt("expected bundle_checksum must be exactly 32 bytes"));
  }
  let mut computed = Bytes.new();
  match compute_tx_bundle_checksum(&records) {
    Err(e) => {
      return Err(e);
    }
    Ok(c) => {
      computed = c;
    }
  }
  if !ct_eq(&computed, &expected_bundle_checksum) {
    return Err(DbError.Corrupt("tx bundle checksum mismatch: transaction records corrupted or missing"));
  }
  return Ok(true);
}
