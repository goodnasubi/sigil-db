module tests.files
  targets server
  trust none

use db.error.DbError;

// 試験用のファイル補助: 読み書き・コピー・改ざん・ディレクトリの掃除

pub fn read_all(path: &String) -> Result<Bytes, DbError>
  intent "ファイル全体を読む（64 MiB まで）"
  requires none
  ensures none
  effects fs.read
{
  return match fs.read_bytes(&Path.new(&path), 67108864) {
    Err(_) => Err(DbError.Io("test helper: cannot read file")),
    Ok(b) => Ok(b),
  };
}

pub fn write_all_file(path: &String, data: &Bytes) -> Result<Bool, DbError>
  intent "ファイルを作成（既存は置換）して書き、同期する"
  requires none
  ensures none
  effects fs
{
  let opts = fs.open_options().read(true).write(true).create(true).truncate(true);
  match opts.open(&Path.new(&path)) {
    Err(_) => {
      return Err(DbError.Io("test helper: cannot open file for writing"));
    }
    Ok(f) => {
      let mut out = f;
      if data.byte_len() > 0 {
        match out.write_all(&data) {
          Err(_) => {
            let _ = out.close();
            return Err(DbError.Io("test helper: cannot write file"));
          }
          Ok(_) => {}
        }
      }
      let _ = out.sync_all();
      let _ = out.close();
      return Ok(true);
    }
  }
}

pub fn join(dir: &String, name: &String) -> String
  intent "dir/name のパス文字列を作る"
  requires none
  ensures none
  effects none
{
  let mut b = dir.as_bytes();
  b.push(47);
  b.extend(&name.as_bytes());
  return b.to_string_utf8().unwrap_or(dir.clone());
}

pub fn copy_file(src: &String, dst: &String) -> Result<Bool, DbError>
  intent "src を dst へコピーする"
  requires none
  ensures none
  effects fs
{
  let data = read_all(&src)?;
  return write_all_file(&dst, &data);
}

pub fn file_len(path: &String) -> Int
  intent "ファイルの大きさ。読めなければ -1"
  requires none
  ensures none
  effects fs.read
{
  return match fs.read_bytes(&Path.new(&path), 67108864) {
    Err(_) => -1,
    Ok(b) => b.byte_len(),
  };
}

pub fn dir_exists(path: &String) -> Bool
  intent "ディレクトリがあるかを返す"
  requires none
  ensures none
  effects fs
{
  match fs.open_dir(&Path.new(&path)) {
    Err(_) => {
      return false;
    }
    Ok(d) => {
      let _ = d.close();
      return true;
    }
  }
}

pub fn list_files(dir: &String) -> List<String>
  intent "ディレクトリの通常ファイル名を列挙する（無ければ空）"
  requires none
  ensures none
  effects fs
{
  let mut names = List.new();
  match fs.open_dir(&Path.new(&dir)) {
    Err(_) => {
      return names;
    }
    Ok(d) => {
      match d.read_entries(64) {
        Err(_) => {}
        Ok(es) => {
          let mut i = 0;
          while i < es.len() {
            match es.get(i) {
              None => {}
              Some(e) => {
                names.push(e.name());
              }
            }
            i = i + 1;
          }
        }
      }
      let _ = d.close();
      return names;
    }
  }
}

pub fn remove_tree(dir: &String)
  intent "ディレクトリ内の通常ファイルをすべて消してディレクトリも消す（試験の後始末）"
  requires none
  ensures none
  effects fs
{
  let names = list_files(&dir);
  let mut i = 0;
  while i < names.len() {
    match names.get(i) {
      None => {}
      Some(n) => {
        let _ = fs.remove_file(&Path.new(&join(&dir, &n)));
      }
    }
    i = i + 1;
  }
  let _ = fs.remove_dir(&Path.new(&dir));
}

pub fn mutate_byte(path: &String, offset: Int) -> Result<Bool, DbError>
  intent "ファイルの offset 番目の 1 byte を反転して書き戻す"
  requires none
  ensures none
  effects fs
{
  let mut data = read_all(&path)?;
  let b = data.get(offset).unwrap_or(0);
  let _ = data.set(offset, b ^ 255);
  return write_all_file(&path, &data);
}

pub fn truncate_to(path: &String, len: Int) -> Result<Bool, DbError>
  intent "ファイルを先頭 len byte にする"
  requires none
  ensures none
  effects fs
{
  let data = read_all(&path)?;
  return write_all_file(&path, &data.slice(0, len).unwrap_or(Bytes.new()));
}
