// ADR 0045 完了条件 4: 保存ページ・WAL・checkpoint・manifest のファジング（決定的）。
//
// 検査対象の DB は、固定 seed の操作列で作る。本体ファイルにはページが、WAL には checkpoint 後の 2 tx が、checkpoint.meta には
// 確定位置が入る。バックアップは WAL を回収した時点（8 tx 目まで）で取る。
// 破壊は固定 seed の擬似乱数から作る（FUZZ_SEED）。種類は、1 bit 反転・1 byte 置換・切断・末尾への追記・範囲の 0 埋め・
// 4 byte を 0xFFFFFFFF（長さ溢れ）に置換・範囲の複製・ブロック入れ替え。位置の半分はヘッダ（先頭 96 byte）を狙う。
//   検査値あり（本体・WAL・meta）: open か検証が失敗するか、論理状態が（WAL は commit 済みの接頭辞のどれか、それ以外は元の状態）と
//     一致しなければならない。壊れたデータを違う論理状態として受理したら失敗。process の異常終了（panic）も失敗として現れる。
//   検査値を再計算（構造のファジング）: 検査値を直した上で本体ページの中身を壊す。検査値は通るので、構造の検証（木の順序・参照・深さ・
//     循環）が壊れた入力で panic・過大割当て・無限ループを起こさず、失敗か検証済みの状態になることを確かめる（内容の改ざんは
//     検査値のない設計上検出できないので、論理状態の一致は求めない）。
//   manifest・complete・バックアップ内の本体: verify_backup は必ず失敗する（変更されなかった場合を除く）。

pub fn fuzz_seed() -> Int
  intent "ファジングの固定 seed（docs/VERIFICATION.md に記録）"
  requires none
  ensures none
  effects none
{
  return 20261118;
}

pub struct Victim {
  states: List<List<Row>>,
}

fn new_row_copy(r: &Row) -> Row
  intent "Row の複製"
  requires none
  ensures none
  effects none
{
  return new_row(r.id, r.grp, r.nm, r.seed);
}

fn run_batch(database: &mut Database, plans: &List<TxPlan>, rows_in: &List<Row>, states: &mut List<List<Row>>) -> Result<List<Row>, DbError>
  intent "操作列を実行し、commit ごとの期待状態を states に足す。最後の状態を返す"
  requires none
  ensures none
  effects fs
{
  let mut rows = List.new();
  let mut i = 0;
  while i < rows_in.len() {
    match rows_in.get(i) {
      None => {}
      Some(r) => {
        rows.push(new_row_copy(&r));
      }
    }
    i = i + 1;
  }
  let mut p = 0;
  while p < plans.len() {
    match plans.get(p) {
      None => {}
      Some(plan) => {
        let o = apply_plan_model(&rows, &plan);
        let r = run_plan(&mut database, &plan)?;
        expect(r.failure == o.err, &"error kind must match the model")?;
        if r.acked {
          rows = o.rows;
          let mut snap = List.new();
          let mut j = 0;
          while j < rows.len() {
            match rows.get(j) {
              None => {}
              Some(x) => {
                snap.push(new_row_copy(&x));
              }
            }
            j = j + 1;
          }
          states.push(snap);
        }
        if plan.checkpoint_after {
          checkpoint_database(&mut database)?;
        }
      }
    }
    p = p + 1;
  }
  return Ok(rows);
}

fn build_victim(vdir: &String, bdir: &String) -> Result<Victim, DbError>
  intent "検査対象の DB（本体・WAL・meta）とバックアップを作る"
  requires none
  ensures none
  effects fs
{
  clean_dir(&vdir);
  remove_tree(&bdir);
  let mut database = open_database(vdir.clone(), sample_db_id())?;
  setup_schema(&mut database)?;
  let mut states = List.new();
  states.push(List.new());
  let first = gen_plans(fuzz_seed(), 8, 14, 3);
  let rows = run_batch(&mut database, &first, &List.new(), &mut states)?;
  backup_database(&mut database, bdir.clone())?;
  let second = gen_plans(fuzz_seed() + 7, 3, 14, 0);
  run_batch(&mut database, &second, &rows, &mut states)?;
  close_database(database)?;
  return Ok(Victim { states: states });
}

fn pick_pos(len: Int, block: Int, seed: Int) -> Int
  intent "壊す位置: 半分は block の先頭 96 byte（ヘッダ）を狙う"
  requires none
  ensures none
  effects none
{
  if len <= 0 {
    return 0;
  }
  if seed / 8 % 2 == 0 && len > block {
    let blocks = len / block;
    return seed / 16 % blocks * block + seed / 4096 % 96;
  }
  return seed / 16 % len;
}

fn mutate(data: &Bytes, block: Int, seed_in: Int) -> Bytes
  intent "seed から決まる 1 種類の破壊を data に施す"
  requires none
  ensures none
  effects none
{
  let mut seed = lcg_next(seed_in);
  let kind = seed / 64 % 8;
  let len = data.len();
  let pos = pick_pos(len, block, seed);
  let mut out = data.clone();
  seed = lcg_next(seed);
  if kind == 0 {
    let _ = out.set(pos, data.get(pos).unwrap_or(0) + 1 + seed / 8 % 2 * 127 & 255);
  }
  if kind == 1 {
    let _ = out.set(pos, data.get(pos).unwrap_or(0) + 1 + seed / 8 % 255 & 255);
  }
  if kind == 2 {
    out = data.slice(0, seed / 16 % (len + 1)).unwrap_or(Bytes.new());
  }
  if kind == 3 {
    let extra = seed / 16 % 64 + 1;
    let mut i = 0;
    while i < extra {
      seed = lcg_next(seed);
      out.push(seed / 8 & 255);
      i = i + 1;
    }
  }
  if kind == 4 {
    let span = seed / 16 % 240 + 16;
    let mut i = 0;
    while i < span && pos + i < len {
      let _ = out.set(pos + i, 0);
      i = i + 1;
    }
  }
  if kind == 5 {
    let mut i = 0;
    while i < 4 && pos + i < len {
      let _ = out.set(pos + i, 255);
      i = i + 1;
    }
  }
  if kind == 6 {
    let span = seed / 16 % 200 + 1;
    let part = data.slice(pos, pos + span).unwrap_or(Bytes.new());
    out.extend(&part);
  }
  if kind == 7 && len >= block * 2 {
    let blocks = len / block;
    let a = seed / 16 % blocks;
    let b = seed / 4096 % blocks;
    let pa = data.slice(a * block, a * block + block).unwrap_or(Bytes.new());
    let pb = data.slice(b * block, b * block + block).unwrap_or(Bytes.new());
    let mut i = 0;
    while i < block {
      let _ = out.set(a * block + i, pb.get(i).unwrap_or(0));
      let _ = out.set(b * block + i, pa.get(i).unwrap_or(0));
      i = i + 1;
    }
  }
  return out;
}

fn same_bytes(a: &Bytes, b: &Bytes) -> Bool
  intent "2 つのバイト列が同じか"
  requires none
  ensures none
  effects none
{
  return a.len() == b.len() && ct_eq(&a, &b);
}

pub struct FuzzStats {
  runs: Int,
  rejected: Int,
  unchanged_or_equal: Int,
}

fn state_in(database: &mut Database, states: &List<List<Row>>, any_prefix: Bool, deep: Bool) -> Result<Bool, DbError>
  intent "論理状態が許される状態のどれかに一致するか（any_prefix なら全ての commit 済み接頭辞、そうでなければ最後だけ）"
  requires none
  ensures none
  effects fs
{
  let mut i = states.len();
  while i > 0 {
    i = i - 1;
    match states.get(i) {
      None => {}
      Some(rows) => {
        let mut m = false;
        if deep {
          m = state_matches_light(&mut database, &rows)?;
        } else {
          m = state_matches_quick(&mut database, &rows)?;
        }
        if m {
          return Ok(true);
        }
        if !any_prefix {
          return Ok(false);
        }
      }
    }
  }
  return Ok(false);
}

fn fuzz_db_file(vdir: &String, work: &String, name: &String, block: Int, iters: Int, any_prefix: Bool, deep: Bool, salt: Int, states: &List<List<Row>>) -> Result<FuzzStats, DbError>
  intent "DB の 1 ファイルを繰り返し壊して開き、壊れたデータを違う状態として受理しないことを確かめる"
  requires none
  ensures none
  effects fs
{
  let orig = read_all(&join(&vdir, &name))?;
  let mut rejected = 0;
  let mut same = 0;
  let mut i = 0;
  while i < iters {
    clean_dir(&work);
    match fs.create_dir_all(&Path.new(&work)) {
      Err(_) => {
        return Err(DbError.Io("fuzz: cannot create work dir"));
      }
      Ok(_) => {}
    }
    copy_file(&join(&vdir, &"main.db"), &join(&work, &"main.db"))?;
    copy_file(&join(&vdir, &"wal.log"), &join(&work, &"wal.log"))?;
    copy_file(&join(&vdir, &"checkpoint.meta"), &join(&work, &"checkpoint.meta"))?;
    let broken = mutate(&orig, block, fuzz_seed() + salt * 100003 + i * 7919);
    write_all_file(&join(&work, &name), &broken)?;
    let unchanged = same_bytes(&broken, &orig);
    match open_database(work.clone(), sample_db_id()) {
      Err(_) => {
        rejected = rejected + 1;
        expect(!unchanged, &"an unchanged file must open")?;
      }
      Ok(d) => {
        let mut database = d;
        let mut accepted_ok = false;
        let mut engine_err = false;
        match state_in(&mut database, &states, any_prefix, deep) {
          Err(_) => {
            engine_err = true;
          }
          Ok(b) => {
            accepted_ok = b;
          }
        }
        close_database(database)?;
        if engine_err {
          rejected = rejected + 1;
        } else {
          expect(accepted_ok, &"corrupt data must not be accepted as a different logical state")?;
          same = same + 1;
        }
      }
    }
    i = i + 1;
  }
  clean_dir(&work);
  return Ok(FuzzStats { runs: iters, rejected: rejected, unchanged_or_equal: same });
}

fn recompute_page_checksums(data: &Bytes, from_page: Int, to_page: Int) -> Bytes
  intent "本体の指定ページ範囲の検査値を計算し直した複製"
  requires none
  ensures none
  effects none
{
  let mut out = data.clone();
  let mut p = from_page;
  while p < to_page && (p + 1) * 8192 <= data.len() {
    let mut page = data.slice(p * 8192, (p + 1) * 8192).unwrap_or(Bytes.new());
    apply_checksum(&mut page);
    let mut i = 0;
    while i < 8192 {
      let _ = out.set(p * 8192 + i, page.get(i).unwrap_or(0));
      i = i + 1;
    }
    p = p + 1;
  }
  return out;
}

fn fuzz_structure(vdir: &String, work: &String, iters: Int) -> Result<FuzzStats, DbError>
  intent "検査値を計算し直した上で本体のページ内容を壊し、構造の検証が panic・無限ループ無しに失敗か検証済みの状態になることを確かめる"
  requires none
  ensures none
  effects fs
{
  let orig = read_all(&join(&vdir, &"main.db"))?;
  let pages = orig.len() / 8192;
  let mut rejected = 0;
  let mut ok_count = 0;
  let mut i = 0;
  while i < iters {
    let seed = fuzz_seed() + 555 + i * 104729;
    let broken0 = mutate(&orig, 8192, seed);
    // 壊した可能性のあるページ全ての検査値を計算し直す（長さが変わった場合は残りを切る／足りない分はそのまま）
    let broken = recompute_page_checksums(&broken0, 1, pages + 1);
    clean_dir(&work);
    match fs.create_dir_all(&Path.new(&work)) {
      Err(_) => {
        return Err(DbError.Io("fuzz: cannot create work dir"));
      }
      Ok(_) => {}
    }
    write_all_file(&join(&work, &"main.db"), &broken)?;
    copy_file(&join(&vdir, &"wal.log"), &join(&work, &"wal.log"))?;
    copy_file(&join(&vdir, &"checkpoint.meta"), &join(&work, &"checkpoint.meta"))?;
    match open_database(work.clone(), sample_db_id()) {
      Err(_) => {
        rejected = rejected + 1;
      }
      Ok(d) => {
        let mut database = d;
        // 木の走査と内部検証を走らせる。結果は失敗でも成功でもよい（panic と無限ループが無いことが条件）
        match state_matches_light(&mut database, &List.new()) {
          Err(_) => {
            rejected = rejected + 1;
          }
          Ok(_) => {
            ok_count = ok_count + 1;
          }
        }
        close_database(database)?;
      }
    }
    i = i + 1;
  }
  clean_dir(&work);
  return Ok(FuzzStats { runs: iters, rejected: rejected, unchanged_or_equal: ok_count });
}

fn fuzz_backup(bdir: &String, work: &String, iters: Int) -> Result<FuzzStats, DbError>
  intent "バックアップの manifest・complete・本体を壊し、verify_backup が必ず失敗することを確かめる"
  requires none
  ensures none
  effects fs
{
  let names_n = 3;
  let mut rejected = 0;
  let mut i = 0;
  while i < iters {
    let which = i % names_n;
    let mut name = "backup.manifest";
    if which == 1 {
      name = "backup.complete";
    }
    if which == 2 {
      name = "main.db";
    }
    remove_tree(&work);
    match fs.create_dir_all(&Path.new(&work)) {
      Err(_) => {
        return Err(DbError.Io("fuzz: cannot create work dir"));
      }
      Ok(_) => {}
    }
    copy_file(&join(&bdir, &"main.db"), &join(&work, &"main.db"))?;
    copy_file(&join(&bdir, &"checkpoint.meta"), &join(&work, &"checkpoint.meta"))?;
    copy_file(&join(&bdir, &"backup.manifest"), &join(&work, &"backup.manifest"))?;
    copy_file(&join(&bdir, &"backup.complete"), &join(&work, &"backup.complete"))?;
    let orig = read_all(&join(&bdir, &name))?;
    let broken = mutate(&orig, 8192, fuzz_seed() + 31 + i * 6151);
    write_all_file(&join(&work, &name), &broken)?;
    let unchanged = same_bytes(&broken, &orig);
    match verify_backup(work.clone()) {
      Err(_) => {
        rejected = rejected + 1;
      }
      Ok(_) => {
        expect(unchanged, &"a modified backup must fail verification")?;
      }
    }
    i = i + 1;
  }
  remove_tree(&work);
  return Ok(FuzzStats { runs: iters, rejected: rejected, unchanged_or_equal: iters - rejected });
}

fn run_fuzz(vdir: &String, bdir: &String, work: &String) -> Result<Bool, DbError>
  intent "全てのファジングを実行して件数を出力する"
  requires none
  ensures none
  effects console, fs
{
  let victim = build_victim(&vdir, &bdir)?;
  let a = fuzz_db_file(&vdir, &work, &"main.db", 8192, 24, false, true, 1, &victim.states)?;
  let b = fuzz_db_file(&vdir, &work, &"wal.log", 8288, 24, true, false, 2, &victim.states)?;
  let c = fuzz_db_file(&vdir, &work, &"checkpoint.meta", 96, 14, true, false, 3, &victim.states)?;
  let d = fuzz_structure(&vdir, &work, 20)?;
  let e = fuzz_backup(&bdir, &work, 18)?;
  console.log(&"fuzz runs main/wal/meta/structure/backup, rejected");
  console.log(&int_to_string(a.runs));
  console.log(&int_to_string(a.rejected));
  console.log(&int_to_string(b.runs));
  console.log(&int_to_string(b.rejected));
  console.log(&int_to_string(c.runs));
  console.log(&int_to_string(c.rejected));
  console.log(&int_to_string(d.runs));
  console.log(&int_to_string(d.rejected));
  console.log(&int_to_string(e.runs));
  console.log(&int_to_string(e.rejected));
  return Ok(true);
}

pub fn run_fuzz_tests() -> Bool
  intent "ファジングの試験を実行する"
  requires none
  ensures none
  effects console, fs
{
  let vdir = "/tmp/sigil_db_test_fuzz_victim";
  let bdir = "/tmp/sigil_db_test_fuzz_backup";
  let work = "/tmp/sigil_db_test_fuzz_work";
  let r = run_fuzz(&vdir, &bdir, &work);
  clean_dir(&vdir);
  clean_dir(&work);
  remove_tree(&bdir);
  return match r {
    Err(e) => report(&"fuzz", &e),
    Ok(_) => true,
  };
}
